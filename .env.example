# Copy to .env and fill in. NEVER commit .env.

# --- Application ---------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text

# --- Database ------------------------------------------------------------
# Local (non-Docker) runs. docker-compose overrides this for the api container.
DATABASE_URL=postgresql+psycopg://fpm:fpm@localhost:5432/northern_news_monitor
POSTGRES_USER=fpm
POSTGRES_PASSWORD=fpm
POSTGRES_DB=northern_news_monitor
# Host port for the Docker db. Use 5433 if a native PostgreSQL already owns 5432
# (then also change the port in DATABASE_URL above).
POSTGRES_PORT=5432

# --- Data provider -------------------------------------------------------
# mock  = realistic fake data, no Facebook access (default)
# meta  = official Meta Graph API (Pages only; Groups API was removed by Meta)
DATA_PROVIDER=mock

# Required when DATA_PROVIDER=meta
META_ACCESS_TOKEN=
# Use a current version from https://developers.facebook.com/docs/graph-api/changelog
META_API_VERSION=v25.0
# Optional. When META_APP_SECRET is set, requests include appsecret_proof.
META_APP_ID=
META_APP_SECRET=
META_PAGE_SIZE=100
META_MAX_PAGES=10

HTTP_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=2
PROVIDER_BACKOFF_MAX_SECONDS=60

# --- Collection ----------------------------------------------------------
FETCH_OVERLAP_MINUTES=10
# Window used the first time a source is collected
INITIAL_LOOKBACK_HOURS=24
COLLECTION_RUN_STALE_MINUTES=180
STORE_RAW_TEXT=false
REMOVE_URLS=false

# --- Notifications -------------------------------------------------------
# none | console
NOTIFICATION_PROVIDER=console

# --- API security --------------------------------------------------------
# Required for every /api/v1 endpoint. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
# Comma-separated, e.g. http://localhost:5678 ; leave empty to disable CORS
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=1048576
CSV_ESCAPE_FORMULAS=true

# --- Northern-areas weather/hazard news (public feeds + Open-Meteo) ------
NEWS_ENABLED=true
NEWS_USER_AGENT=northern-news-monitor/0.1 (northern-areas weather news monitor)
NEWS_MAX_RESPONSE_BYTES=5000000
NEWS_SUMMARY_CHARS=600
# Forecast alert thresholds (per day)
WEATHER_SNOWFALL_CM=2
WEATHER_PRECIPITATION_MM=25
WEATHER_WIND_GUST_KMH=60
WEATHER_FORECAST_DAYS=3
